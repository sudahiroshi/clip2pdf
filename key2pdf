#!/usr/bin/env node
// tako:run: ./key2pdf --help
//
// key2pdf — Keynote のスライドから図の部分だけを切り出した PDF を作る。
//
// Keynote の書き出しは「スライド1枚 = 1ページ」なので図の周りにスライドの余白が残る。
// 切り抜きの中身は lib/crop.js にあり、PDF 単体を扱う pdftrim と共通。

'use strict';

const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const { spawnSync } = require('node:child_process');
const { parseArgs } = require('node:util');
const { PDFDocument } = require('pdf-lib');
const crop = require('./lib/crop');

const PROG = 'key2pdf';
const { info, debug, warn, die } = crop;

// ---------------------------------------------------------------- Keynote 書き出し

// 引数を素直に渡せる JXA を使う。
const JXA_EXPORT = `
function run(argv) {
  var srcPath = argv[0], dstPath = argv[1];
  var kn = Application("Keynote");
  ObjC.import("Foundation");
  function sleep(sec) { $.NSThread.sleepForTimeInterval(sec); }

  // file() は環境によって Path("/x/y.key") のような表記で返るため、パス部分だけ取り出す
  function normPath(v) {
    var s = String(v);
    var m = /\\/.*$/.exec(s);
    return m ? m[0].replace(/["')\\]]+$/, "") : s;
  }
  function findDoc() {
    var docs = kn.documents;
    for (var i = 0; i < docs.length; i++) {
      var f = null;
      try { f = docs[i].file(); } catch (e) {}
      if (f && normPath(f) === srcPath) { return docs[i]; }
    }
    return null;
  }

  var doc = findDoc();
  var wasOpen = doc !== null;
  if (!doc) {
    var opened = kn.open(Path(srcPath));
    // 開き終わるまで待つ。documents[0] は別の書類を指すことがあるので必ずパスで特定する
    for (var t = 0; t < 100 && !doc; t++) {
      doc = findDoc();
      if (!doc) { sleep(0.1); }
    }
    // パスで見つからないときだけ open() の戻り値に頼る
    if (!doc && opened) { try { opened.slides.length; doc = opened; } catch (e) {} }
    if (!doc) { throw new Error("開いた書類を特定できませんでした: " + srcPath); }
  }
  var count = doc.slides.length;
  kn.export(doc, {
    to: Path(dstPath),
    as: "PDF",
    withProperties: {
      exportStyle: "IndividualSlides",
      allStages: false,
      skippedSlides: false,
      pdfImageQuality: "Best"
    }
  });
  // ユーザの作業中の書類を勝手に閉じないよう、こちらで開いた場合だけ閉じる
  if (!wasOpen) { doc.close({ saving: "no" }); }
  return String(count);
}
`;

// 書き出したスライド枚数を返す
function exportKeynote(src, dst) {
  debug(`Keynote で書き出し: ${path.basename(src)}`);
  const res = spawnSync('osascript', ['-l', 'JavaScript', '-', src, dst], {
    input: JXA_EXPORT, encoding: 'utf8',
  });
  if (res.error) die(`osascript を起動できませんでした: ${res.error.message}`);
  if (res.status !== 0) {
    const detail = (res.stderr || res.stdout || '').trim();
    let hint = '';
    if (detail.includes('-1743') || detail.includes('Not authorized')) {
      hint = '\n  システム設定 > プライバシーとセキュリティ > オートメーション で、'
           + 'ターミナルから Keynote を操作する許可を与えてください。';
    }
    die(`Keynote での書き出しに失敗しました。\n  ${detail}${hint}`);
  }
  if (!fs.existsSync(dst)) {
    die('Keynote が PDF を出力しませんでした（パスワード保護された書類かもしれません）');
  }
  debug(`書き出し完了: ${dst}`);
  const n = Number.parseInt((res.stdout || '').trim(), 10);
  return Number.isFinite(n) ? n : null;
}

// ---------------------------------------------------------------- 引数

const USAGE = `使い方: ${PROG} [オプション] <file.key | file.pdf>

Keynote のスライドから図の部分だけを切り出した PDF を作る
（PDF の余白だけを落としたいときは pdftrim を使ってください）

オプション:
  -o, --output DIR    出力先ディレクトリ（既定: 入力と同じ場所）
      --prefix NAME   出力名の接頭辞（既定: 入力ファイル名）
      --slide SPEC    対象スライド。例: 1,3-5（既定: 全部）
      --margin PT     切り抜きに残す余白 pt（既定: 0）
      --dpi N         bbox 検出のラスタ解像度（既定: 150）
      --bg SPEC       背景色 auto|#RRGGBB|none（none で切り抜きなし）
      --tolerance N   背景とみなす色差 0-255（既定: 8）
      --noise N       差分画素が N 個以下の行・列は無視する（既定: 0）
      --merge         複数ページの PDF 1本にまとめて出力する
      --force         既存ファイルを上書きする
      --keep-uncropped  切り抜き前の PDF も残す（デバッグ用）
  -v, --verbose       詳細を表示する
  -q, --quiet         進捗を表示しない
  -h, --help          この使い方を表示する

例:
  ${PROG} figures.key              → figures-01.pdf, figures-02.pdf …
  ${PROG} --slide 3 --margin 2 figures.key
  ${PROG} -o ~/paper/fig --prefix energy figures.key
`;

function parseCli(argv) {
  let parsed;
  try {
    parsed = parseArgs({
      args: argv,
      allowPositionals: true,
      options: {
        output: { type: 'string', short: 'o' },
        prefix: { type: 'string' },
        slide: { type: 'string', default: '' },
        margin: { type: 'string', default: '0' },
        dpi: { type: 'string', default: '150' },
        bg: { type: 'string', default: 'auto' },
        tolerance: { type: 'string', default: '8' },
        noise: { type: 'string', default: '0' },
        merge: { type: 'boolean', default: false },
        force: { type: 'boolean', default: false },
        'keep-uncropped': { type: 'boolean', default: false },
        verbose: { type: 'boolean', short: 'v', default: false },
        quiet: { type: 'boolean', short: 'q', default: false },
        help: { type: 'boolean', short: 'h', default: false },
      },
    });
  } catch (e) {
    die(`${e.message}\n\n${USAGE}`);
  }
  const { values: v, positionals } = parsed;
  if (v.help) { process.stdout.write(USAGE); process.exit(0); }
  if (positionals.length === 0) die(`変換するファイルを指定してください。\n\n${USAGE}`);
  if (positionals.length > 1) die(`入力は1つだけ指定してください: ${positionals.join(', ')}`);
  return {
    input: positionals[0],
    output: v.output,
    prefix: v.prefix,
    slide: v.slide,
    margin: crop.num(v.margin, '--margin'),
    dpi: crop.num(v.dpi, '--dpi', { int: true, min: 12, max: 2400 }),
    bg: v.bg,
    tolerance: crop.num(v.tolerance, '--tolerance', { int: true, min: 0, max: 255 }),
    noise: crop.num(v.noise, '--noise', { int: true, min: 0 }),
    merge: v.merge,
    force: v.force,
    keepUncropped: v['keep-uncropped'],
    verbose: v.verbose,
    quiet: v.quiet,
  };
}

// ---------------------------------------------------------------- 本体

async function main() {
  const args = parseCli(process.argv.slice(2));
  crop.configure({ prog: PROG, verbose: args.verbose, quiet: args.quiet });

  let src = path.resolve(crop.expandHome(args.input));
  if (!fs.existsSync(src)) die(`入力ファイルがありません: ${src}`);
  src = fs.realpathSync(src);
  const suffix = path.extname(src).toLowerCase();
  if (suffix !== '.key' && suffix !== '.pdf') {
    die(`対応していない形式です: ${path.extname(src)}（.key か .pdf を指定してください）`);
  }

  const outDir = args.output ? path.resolve(crop.expandHome(args.output)) : path.dirname(src);
  fs.mkdirSync(outDir, { recursive: true });
  const prefix = args.prefix || path.basename(src, path.extname(src));
  const doCrop = args.bg !== 'none';
  const bg = doCrop ? crop.parseBg(args.bg) : null;
  const gs = doCrop ? crop.findGs() : null;

  const tmpdir = fs.mkdtempSync(path.join(os.tmpdir(), 'key2pdf-'));
  try {
    let pdf = src;
    let slideCount = null;
    if (suffix === '.key') {
      pdf = path.join(tmpdir, `${path.basename(src, '.key')}.pdf`);
      info(`Keynote から書き出し中: ${path.basename(src)}`);
      slideCount = exportKeynote(src, pdf);
      if (args.keepUncropped) {
        const kept = path.join(outDir, `${prefix}-uncropped.pdf`);
        if (fs.existsSync(kept) && !args.force) {
          die(`すでに存在します: ${kept}（上書きするなら --force）`);
        }
        fs.copyFileSync(pdf, kept);
        info(`切り抜き前: ${kept}`);
      }
    }

    const srcDoc = await PDFDocument.load(fs.readFileSync(pdf), { updateMetadata: false });
    const total = srcDoc.getPageCount();
    if (slideCount !== null && slideCount !== total) {
      // スキップ指定のスライドは書き出されないので、その分ずれることがある
      warn(`Keynote の ${slideCount} 枚に対し書き出しは ${total} ページでした`
         + '（スキップ設定のスライドは書き出されません）');
    }
    const pageNos = crop.parsePageSpec(args.slide, total, '--slide');
    debug(`全 ${total} ページ中 ${pageNos.length} ページを処理`);

    const results = pageNos.map((pageNo) => ({
      pageNo,
      box: doCrop ? crop.detectCropBox({
        gs, pdf, page: srcDoc.getPage(pageNo - 1), pageNo, tmpdir,
        dpi: args.dpi, margin: args.margin, bg,
        tolerance: args.tolerance, noise: args.noise,
        label: `スライド ${pageNo}`,
      }) : null,
    }));

    // 連番を省くのは書類全体が1枚のときだけ。--slide で1枚選んだ場合は番号を残す
    let targets;
    if (args.merge || total === 1) {
      targets = [{ file: path.join(outDir, `${prefix}.pdf`), items: results }];
    } else {
      const width = Math.max(2, String(Math.max(...results.map((r) => r.pageNo))).length);
      targets = results.map((r) => ({
        file: path.join(outDir, `${prefix}-${String(r.pageNo).padStart(width, '0')}.pdf`),
        items: [r],
      }));
    }

    // 一部だけ書いて止まらないよう、書き始める前にまとめて確認する
    if (!args.force) {
      const clash = targets.find((t) => fs.existsSync(t.file));
      if (clash) die(`すでに存在します: ${clash.file}（上書きするなら --force）`);
    }

    for (const { file, items } of targets) {
      await crop.writePdf(srcDoc, items, file);
      info(file);
    }
  } finally {
    fs.rmSync(tmpdir, { recursive: true, force: true });
  }
}

main().catch((e) => die(e && e.stack ? e.stack : String(e)));
