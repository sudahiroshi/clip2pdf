#!/usr/bin/env -S uv run --script
# tako:run: ./key2pdf --help
# /// script
# requires-python = ">=3.9"
# dependencies = ["pypdf>=4.0", "pillow>=9.0"]
# ///
"""key2pdf — Keynote のスライドから図の部分だけを切り出した PDF を作る。

Keynote の書き出しは「スライド1枚 = 1ページ」なので図の周りにスライドの余白が残る。
本ツールはページを一度ラスタ化して「背景色と異なる画素」の範囲を求め、
ページ矩形(MediaBox/CropBox)をそこまで切り詰める。ページ内容は再エンコード
しないのでベクタのまま TeX の \\includegraphics に貼れる。
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

PROG = "key2pdf"
MAX_RASTER_PX = 8000  # ラスタ化時の1辺の上限。超えるなら dpi を自動で下げる

# ---------------------------------------------------------------- 出力


class Log:
    def __init__(self, verbose=False, quiet=False):
        self.verbose = verbose
        self.quiet = quiet

    def info(self, msg):
        if not self.quiet:
            print(msg, file=sys.stderr)

    def debug(self, msg):
        if self.verbose and not self.quiet:
            print(f"  {msg}", file=sys.stderr)

    def warn(self, msg):
        print(f"{PROG}: 警告: {msg}", file=sys.stderr)


def die(msg, code=1):
    print(f"{PROG}: エラー: {msg}", file=sys.stderr)
    sys.exit(code)


# ---------------------------------------------------------------- ① Keynote 書き出し

# 引数を素直に渡せる JXA を使う。すでに開いている書類なら開き直さず、
# こちらで開いた場合だけ閉じる（ユーザの作業中の書類を勝手に閉じないため）。
JXA_EXPORT = r"""
function run(argv) {
  var srcPath = argv[0], dstPath = argv[1];
  var kn = Application("Keynote");
  var doc = null, wasOpen = false;
  var docs = kn.documents;
  for (var i = 0; i < docs.length; i++) {
    var f = null;
    try { f = docs[i].file(); } catch (e) {}
    if (f && String(f).replace(/^Path\(/, "").replace(/\)$/, "") === srcPath) {
      doc = docs[i]; wasOpen = true; break;
    }
  }
  if (!doc) {
    kn.open(Path(srcPath));
    doc = kn.documents[0];
    if (!doc) { throw new Error("Keynote が書類を開けませんでした"); }
  }
  var count = doc.slides.length;
  kn.export(doc, {
    to: Path(dstPath),
    as: "PDF",
    withProperties: {
      exportStyle: "IndividualSlides",
      allStages: false,
      skippedSlides: false,
      pdfImageQuality: "Best"
    }
  });
  if (!wasOpen) { doc.close({ saving: "no" }); }
  return String(count);
}
"""


def export_keynote(src: Path, dst: Path, log: Log) -> None:
    """Keynote に .key を PDF へ書き出させる。"""
    log.debug(f"Keynote で書き出し: {src.name}")
    proc = subprocess.run(
        ["osascript", "-l", "JavaScript", "-", str(src), str(dst)],
        input=JXA_EXPORT, capture_output=True, text=True,
    )
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()
        hint = ""
        if "-1743" in detail or "Not authorized" in detail:
            hint = ("\n  システム設定 > プライバシーとセキュリティ > オートメーション で、"
                    "ターミナルから Keynote を操作する許可を与えてください。")
        die(f"Keynote での書き出しに失敗しました。\n  {detail}{hint}")
    if not dst.exists():
        die("Keynote が PDF を出力しませんでした（パスワード保護された書類かもしれません）")
    log.debug(f"書き出し完了: {dst}")


# ---------------------------------------------------------------- ② bbox 検出


def find_gs() -> str:
    gs = shutil.which("gs") or ("/usr/local/bin/gs" if os.path.exists("/usr/local/bin/gs") else None)
    if not gs:
        die("Ghostscript (gs) が見つかりません。`brew install ghostscript` などで導入してください。")
    return gs


def render_page(gs: str, pdf: Path, page_no: int, dpi: int, out_png: Path, log: Log) -> None:
    cmd = [
        gs, "-q", "-dNOPAUSE", "-dBATCH", "-dSAFER",
        "-sDEVICE=png16m", f"-r{dpi}",
        f"-dFirstPage={page_no}", f"-dLastPage={page_no}",
        "-dUseCropBox", "-dTextAlphaBits=4", "-dGraphicsAlphaBits=4",
        f"-sOutputFile={out_png}", str(pdf),
    ]
    log.debug("gs " + " ".join(cmd[1:]))
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0 or not out_png.exists():
        die(f"ページ {page_no} のラスタ化に失敗しました。\n  {(proc.stderr or proc.stdout).strip()}")


def parse_bg(spec: str):
    """--bg の値を (r,g,b) か None(=auto) に変換する。"""
    if spec == "auto":
        return None
    m = re.fullmatch(r"#?([0-9a-fA-F]{6})", spec)
    if not m:
        die(f"--bg には auto か #RRGGBB を指定してください: {spec!r}")
    h = m.group(1)
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def detect_bbox(png: Path, bg, tolerance: int, log: Log):
    """背景色と異なる画素の bbox を (left, upper, right, lower) px で返す。無地なら None。"""
    from PIL import Image, ImageChops

    img = Image.open(png).convert("RGB")
    if bg is None:
        w, h = img.size
        corners = [img.getpixel(p) for p in ((0, 0), (w - 1, 0), (0, h - 1), (w - 1, h - 1))]
        # 四隅の多数決。割れたら左上を採用する。
        bg = max(set(corners), key=corners.count)
        log.debug(f"背景色を推定: #{bg[0]:02x}{bg[1]:02x}{bg[2]:02x}")
    diff = ImageChops.difference(img, Image.new("RGB", img.size, bg))
    mask = diff.point(lambda v: 255 if v > tolerance else 0)
    return mask.getbbox(), img.size


# ---------------------------------------------------------------- 引数


def parse_slides(spec: str, total: int):
    """"1,3-5" のような指定を 1 始まりのページ番号リストにする。"""
    if not spec:
        return list(range(1, total + 1))
    out = []
    for part in spec.split(","):
        part = part.strip()
        if not part:
            continue
        m = re.fullmatch(r"(\d+)(?:-(\d+))?", part)
        if not m:
            die(f"--slide の書式が不正です: {part!r}（例: 1,3-5）")
        a = int(m.group(1))
        b = int(m.group(2)) if m.group(2) else a
        if a < 1 or b < a:
            die(f"--slide の範囲が不正です: {part!r}")
        out.extend(range(a, b + 1))
    bad = [n for n in out if n > total]
    if bad:
        die(f"スライド {bad[0]} は存在しません（全 {total} 枚）")
    seen, uniq = set(), []
    for n in out:
        if n not in seen:
            seen.add(n)
            uniq.append(n)
    return uniq


def build_parser():
    p = argparse.ArgumentParser(
        prog=PROG,
        description="Keynote のスライドから図の部分だけを切り出した PDF を作る",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="例:\n"
               "  key2pdf figures.key              → figures-01.pdf, figures-02.pdf …\n"
               "  key2pdf --slide 3 --margin 2 figures.key\n"
               "  key2pdf -o ~/paper/fig --prefix energy figures.key\n",
    )
    p.add_argument("input", help="変換する .key（または切り抜きだけ行う .pdf）")
    p.add_argument("-o", "--output", metavar="DIR", help="出力先ディレクトリ（既定: 入力と同じ場所）")
    p.add_argument("--prefix", metavar="NAME", help="出力名の接頭辞（既定: 入力ファイル名）")
    p.add_argument("--slide", metavar="SPEC", default="", help="対象スライド。例: 1,3-5（既定: 全部）")
    p.add_argument("--margin", type=float, default=0.0, metavar="PT", help="切り抜きに残す余白 pt（既定: 0）")
    p.add_argument("--dpi", type=int, default=150, metavar="N", help="bbox 検出のラスタ解像度（既定: 150）")
    p.add_argument("--bg", default="auto", metavar="SPEC", help="背景色 auto|#RRGGBB|none（none で切り抜きなし）")
    p.add_argument("--tolerance", type=int, default=8, metavar="N", help="背景とみなす色差 0-255（既定: 8）")
    p.add_argument("--merge", action="store_true", help="複数ページの PDF 1本にまとめて出力する")
    p.add_argument("--force", action="store_true", help="既存ファイルを上書きする")
    p.add_argument("--keep-uncropped", action="store_true", help="切り抜き前の PDF も残す（デバッグ用）")
    p.add_argument("-v", "--verbose", action="store_true", help="詳細を表示する")
    p.add_argument("-q", "--quiet", action="store_true", help="進捗を表示しない")
    return p


# ---------------------------------------------------------------- 本体


def main():
    args = build_parser().parse_args()
    log = Log(args.verbose, args.quiet)

    src = Path(args.input).expanduser()
    if not src.exists():
        die(f"入力ファイルがありません: {src}")
    src = src.resolve()
    suffix = src.suffix.lower()
    if suffix not in (".key", ".pdf"):
        die(f"対応していない形式です: {src.suffix}（.key か .pdf を指定してください）")
    if args.tolerance < 0 or args.tolerance > 255:
        die("--tolerance は 0-255 で指定してください")
    if args.dpi < 12:
        die("--dpi が小さすぎます")

    out_dir = Path(args.output).expanduser() if args.output else src.parent
    out_dir.mkdir(parents=True, exist_ok=True)
    prefix = args.prefix or src.stem
    crop = args.bg != "none"
    bg = None if not crop else parse_bg(args.bg)
    gs = find_gs() if crop else None

    with tempfile.TemporaryDirectory(prefix="key2pdf-") as tmp:
        tmpdir = Path(tmp)
        if suffix == ".key":
            pdf = tmpdir / (src.stem + ".pdf")
            log.info(f"Keynote から書き出し中: {src.name}")
            export_keynote(src, pdf, log)
            if args.keep_uncropped:
                kept = out_dir / f"{prefix}-uncropped.pdf"
                if kept.exists() and not args.force:
                    die(f"すでに存在します: {kept}（上書きするなら --force）")
                shutil.copy2(pdf, kept)
                log.info(f"切り抜き前: {kept}")
        else:
            pdf = src

        from pypdf import PdfReader, PdfWriter
        from pypdf.generic import NameObject, RectangleObject

        reader = PdfReader(str(pdf))
        total = len(reader.pages)
        pages = parse_slides(args.slide, total)
        log.debug(f"全 {total} ページ中 {len(pages)} ページを処理")

        results = []  # (page_no, page, box or None)
        for page_no in pages:
            page = reader.pages[page_no - 1]
            ref = page.cropbox if page.cropbox else page.mediabox
            x0, y0 = float(ref.left), float(ref.bottom)
            x1, y1 = float(ref.right), float(ref.top)
            w_pt, h_pt = x1 - x0, y1 - y0

            if not crop:
                results.append((page_no, page, None))
                continue

            rot = int(page.get("/Rotate", 0) or 0) % 360
            if rot:
                log.warn(f"スライド {page_no}: /Rotate {rot} のページは切り抜きをスキップします")
                results.append((page_no, page, None))
                continue

            dpi = args.dpi
            longest = max(w_pt, h_pt) * dpi / 72.0
            if longest > MAX_RASTER_PX:
                dpi = max(12, int(MAX_RASTER_PX * 72.0 / max(w_pt, h_pt)))
                log.warn(f"スライドが大きいため検出解像度を {dpi} dpi に下げました")

            png = tmpdir / f"page-{page_no}.png"
            render_page(gs, pdf, page_no, dpi, png, log)
            bbox, (img_w, img_h) = detect_bbox(png, bg, args.tolerance, log)
            png.unlink(missing_ok=True)

            if bbox is None:
                log.warn(f"スライド {page_no}: 背景色以外の内容がありません。切り抜かずに出力します")
                results.append((page_no, page, None))
                continue

            # アンチエイリアスの端が欠けないよう 1px 外に広げる
            left, upper, right, lower = bbox
            left, upper = max(0, left - 1), max(0, upper - 1)
            right, lower = min(img_w, right + 1), min(img_h, lower + 1)
            if (left, upper, right, lower) == (0, 0, img_w, img_h):
                log.warn(f"スライド {page_no}: ページ全体が内容と判定され切り抜けませんでした。"
                         "背景が塗り・画像・グラデーションの可能性があります（--bg で背景色を指定するか白無地テーマを使ってください）")

            s = 72.0 / dpi
            m = args.margin
            nx0 = max(x0, x0 + left * s - m)
            nx1 = min(x1, x0 + right * s + m)
            # 画像は上が原点、PDF は下が原点
            ny1 = min(y1, y1 - upper * s + m)
            ny0 = max(y0, y1 - lower * s - m)
            results.append((page_no, page, (nx0, ny0, nx1, ny1)))
            log.debug(f"スライド {page_no}: {w_pt:.1f}x{h_pt:.1f}pt → "
                      f"{nx1 - nx0:.1f}x{ny1 - ny0:.1f}pt")

        def apply_box(page, box):
            if box is None:
                return page
            page.mediabox = RectangleObject(box)
            page.cropbox = RectangleObject(box)
            for key in ("/BleedBox", "/TrimBox", "/ArtBox"):
                if key in page:
                    page[NameObject(key)] = RectangleObject(box)
            return page

        def write(path: Path, items):
            writer = PdfWriter()
            for page_no, page, box in items:
                writer.add_page(apply_box(page, box))
            with open(path, "wb") as fh:
                writer.write(fh)

        # 連番を省くのは書類全体が1枚のときだけ。--slide で1枚選んだ場合は番号を残す
        if args.merge or total == 1:
            targets = [(out_dir / f"{prefix}.pdf", results)]
        else:
            width = max(2, len(str(max(p for p, _, _ in results))))
            targets = [(out_dir / f"{prefix}-{item[0]:0{width}d}.pdf", [item]) for item in results]

        # 一部だけ書いて止まらないよう、書き始める前にまとめて確認する
        if not args.force:
            clash = [t for t, _ in targets if t.exists()]
            if clash:
                die(f"すでに存在します: {clash[0]}（上書きするなら --force）")

        for target, items in targets:
            write(target, items)
            log.info(f"{target}")


if __name__ == "__main__":
    main()
